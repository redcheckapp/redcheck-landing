<div 
    id="particles-wrapper"
    class="fixed inset-0 pointer-events-none transition-opacity duration-100 ease-out"
    style="opacity: 0; z-index: 1;" 
>
    <div id="tsparticles-landing" class="absolute inset-0"></div>
</div>

<style is:global>
    /* Transición suave del filtro de color sobre el canvas generado por tsParticles */
    #tsparticles-landing canvas {
        transition: filter 0.5s ease;
    }

    /* En modo DÍA: Oscurecemos y aumentamos el contraste del canvas sin reiniciar el motor */
    html:not(.dark) #tsparticles-landing canvas {
        filter: brightness(0.25) opacity(0.8);
    }

    /* En modo NOCHE: El canvas se muestra con sus colores originales (#9ca3af) */
    html.dark #tsparticles-landing canvas {
        filter: brightness(1) opacity(1);
    }
</style>

<script>
    import { tsParticles } from "@tsparticles/engine";
    import { loadSlim } from "@tsparticles/slim";

    const initParticles = async () => {
        await loadSlim(tsParticles);
        
        // 1. Cargamos las partículas UNA SOLA VEZ con la configuración base (noche)
        await tsParticles.load({
            id: "tsparticles-landing",
            options: {
                background: { color: { value: "transparent" } },
                fpsLimit: 120,
                particles: {
                    color: { value: "#9ca3af" }, 
                    links: { color: "#9ca3af", distance: 150, enable: true, opacity: 0.4, width: 1.5 },
                    move: { direction: "none", enable: true, outModes: { default: "bounce" }, random: false, speed: 1.0, straight: false },
                    number: { density: { enable: true, area: 800 }, value: 80 },
                    opacity: { value: 0.6 },
                    shape: { type: "circle" },
                    size: { value: { min: 1, max: 2.5 } },
                },
                detectRetina: true,
            }
        });
        
        console.log("🟢 Partículas cargadas con éxito (Instancia Única)");
    };

    initParticles();

    // 2. Lógica de opacidad atada al scroll (Intacta)
    const wrapper = document.getElementById("particles-wrapper");
    
    if (wrapper) {
        const handleScroll = () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            
            if (docHeight > 0) {
                const scrollPercent = scrollTop / docHeight;
                wrapper.style.opacity = scrollPercent.toString();
            }
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        setTimeout(handleScroll, 50);
    }
</script>