---
import { Sparkles, ArrowDown } from 'lucide-react';
---

<!-- Añadimos 'text-left' al contenedor padre para blindarlo -->
<div class="w-full max-w-3xl mx-auto bg-white dark:bg-[#111827] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col font-sans relative z-10 text-left">
    
    <!-- Barra superior minimalista -->
    <div class="bg-gray-50 dark:bg-gray-900/80 border-b border-gray-200 dark:border-gray-800 px-4 py-3 flex items-center justify-between backdrop-blur-sm">
        <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-amber-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
        </div>
        <!-- Botón de estado de la IA -->
        <div id="demo-ai-status" class="flex items-center gap-2 px-3 py-1 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-500 text-xs font-bold transition-colors duration-300">
            <Sparkles size={14} id="demo-ai-icon" />
            <span id="demo-ai-text" data-es="Esperando tareas..." data-en="Waiting for tasks...">Esperando tareas...</span>
        </div>
    </div>

    <div class="p-5 md:p-6 relative min-h-[260px] bg-white dark:bg-[#0b1120]">
        
        <!-- ESTADO 1: El caos del usuario -->
        <div id="demo-raw" class="flex flex-col gap-3 transition-opacity duration-500 w-full max-w-lg mx-auto">
            <div class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-gray-800/40 border border-gray-200 dark:border-gray-700/50 rounded-xl">
                <div class="w-5 h-5 rounded-[4px] border-2 border-gray-300 dark:border-gray-600"></div>
                <p class="font-medium text-gray-700 dark:text-gray-300" data-es="Configurar entorno local" data-en="Configure local environment">Configurar entorno local</p>
            </div>
            <div class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-gray-800/40 border border-gray-200 dark:border-gray-700/50 rounded-xl">
                <div class="w-5 h-5 rounded-[4px] border-2 border-gray-300 dark:border-gray-600"></div>
                <p class="font-medium text-gray-700 dark:text-gray-300" data-es="Rotar claves del servidor" data-en="Rotate server keys">Rotar claves del servidor</p>
            </div>
        </div>

        <!-- Efecto Escáner -->
        <div id="demo-scanner" class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-transparent via-[#cc2229]/10 to-transparent border-b border-[#cc2229]/30 opacity-0 pointer-events-none hidden z-20"></div>

        <!-- ESTADO 2: El orden de SmartCheck AI -->
        <div id="demo-organized" class="absolute top-6 left-6 right-6 md:top-8 md:left-8 md:right-8 flex flex-col gap-4 opacity-0 pointer-events-none transition-opacity duration-500 max-w-2xl mx-auto">
            
            <!-- Tarea Prioridad Alta -->
            <div class="flex flex-col p-4 bg-[#cc2229]/5 border border-[#cc2229]/20 rounded-xl transform transition-all duration-500 translate-y-4" id="demo-task-high">
                <div class="flex justify-between items-start mb-2">
                    <span class="text-[10px] font-bold tracking-wider text-gray-500 uppercase" data-es="Ciberseguridad" data-en="Cybersecurity">Ciberseguridad</span>
                </div>
                <div class="flex gap-3 items-start">
                    <div class="w-5 h-5 rounded-[4px] border-2 border-[#cc2229] bg-[#cc2229]/10 mt-0.5 flex-shrink-0"></div>
                    <!-- Añadimos 'flex-1 text-left' aquí -->
                    <div class="flex-1 text-left">
                        <p class="font-bold text-gray-900 dark:text-white" data-es="Rotar claves del servidor" data-en="Rotate server keys">Rotar claves del servidor</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-es="Alta prioridad: Caducan credenciales de AWS hoy." data-en="High priority: AWS credentials expire today.">Alta prioridad: Caducan credenciales de AWS hoy.</p>
                        <div class="flex items-center justify-start gap-1.5 mt-2.5">
                            <div class="w-1.5 h-1.5 rounded-full bg-[#cc2229]"></div>
                            <span class="text-[#cc2229] font-semibold text-xs" data-es="Hoy, 20:11" data-en="Today, 20:11">Hoy, 20:11</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarea Prioridad Baja -->
            <div class="flex flex-col p-4 bg-[#00b87c]/5 border border-[#00b87c]/20 rounded-xl transform transition-all duration-500 translate-y-4 delay-100" id="demo-task-low">
                <div class="flex justify-between items-start mb-2">
                    <span class="text-[10px] font-bold tracking-wider text-gray-500 uppercase" data-es="Desarrollo Backend" data-en="Backend Development">Desarrollo Backend</span>
                </div>
                <div class="flex gap-3 items-start">
                    <div class="w-5 h-5 rounded-[4px] border-2 border-[#00b87c] bg-[#00b87c]/10 mt-0.5 flex-shrink-0"></div>
                    <!-- Añadimos 'flex-1 text-left' aquí -->
                    <div class="flex-1 text-left">
                        <p class="font-bold text-gray-900 dark:text-white" data-es="Configurar entorno local" data-en="Configure local environment">Configurar entorno local</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-es="Limpiar contenedores zombis." data-en="Clean zombie containers.">Limpiar contenedores zombis.</p>
                        <div class="flex items-center justify-start gap-1.5 mt-2.5">
                            <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
                            <span class="text-amber-500 font-semibold text-xs" data-es="Mañana, 01:59" data-en="Tomorrow, 01:59">Mañana, 01:59</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    @keyframes scanPass {
        0% { transform: translateY(-100%); opacity: 0; }
        20% { opacity: 1; }
        80% { opacity: 1; }
        100% { transform: translateY(300px); opacity: 0; }
    }
    .animate-scan-pass {
        animation: scanPass 2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
</style>

<script is:inline>
    const initHybridDemo = () => {
        const rawContainer = document.getElementById('demo-raw');
        const organizedContainer = document.getElementById('demo-organized');
        const scanner = document.getElementById('demo-scanner');
        
        const statusBox = document.getElementById('demo-ai-status');
        const statusText = document.getElementById('demo-ai-text');
        const aiIcon = document.getElementById('demo-ai-icon');
        
        const taskHigh = document.getElementById('demo-task-high');
        const taskLow = document.getElementById('demo-task-low');

        if (!rawContainer || !organizedContainer || !scanner) return;

        let isAnimating = false;

        const runCycle = async () => {
            if (isAnimating) return;
            isAnimating = true;

            const lang = document.documentElement.lang || 'es';

            // ESTADO INICIAL
            rawContainer.style.opacity = '1';
            organizedContainer.style.opacity = '0';
            scanner.classList.add('hidden');
            scanner.classList.remove('animate-scan-pass');
            
            taskHigh.classList.add('translate-y-4');
            taskHigh.classList.remove('translate-y-0');
            taskLow.classList.add('translate-y-4');
            taskLow.classList.remove('translate-y-0');

            statusBox.className = 'flex items-center gap-2 px-3 py-1 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-500 text-xs font-bold transition-colors duration-300';
            statusText.textContent = lang === 'en' ? 'Waiting for tasks...' : 'Esperando tareas...';
            aiIcon.classList.remove('animate-pulse');

            // Tiempo que el usuario ve el "caos"
            await new Promise(r => setTimeout(r, 1500));

            // INICIA EL ANÁLISIS
            statusBox.className = 'flex items-center gap-2 px-3 py-1 rounded-full bg-[#cc2229]/10 text-[#cc2229] text-xs font-bold transition-colors duration-300 border border-[#cc2229]/20';
            statusText.textContent = lang === 'en' ? 'SmartCheck AI Analyzing...' : 'SmartCheck AI Analizando...';
            aiIcon.classList.add('animate-pulse');
            
            scanner.classList.remove('hidden');
            scanner.classList.add('animate-scan-pass');

            await new Promise(r => setTimeout(r, 1200));

            // TRANSICIÓN
            rawContainer.style.opacity = '0';
            await new Promise(r => setTimeout(r, 400));
            organizedContainer.style.opacity = '1';
            
            setTimeout(() => taskHigh.classList.remove('translate-y-4'), 100);
            setTimeout(() => taskLow.classList.remove('translate-y-4'), 300);

            // FINALIZADO
            statusBox.className = 'flex items-center gap-2 px-3 py-1 rounded-full bg-[#00b87c]/10 text-[#00b87c] text-xs font-bold transition-colors duration-300 border border-[#00b87c]/20';
            statusText.textContent = lang === 'en' ? 'Optimized' : 'Optimizado';
            aiIcon.classList.remove('animate-pulse');

            isAnimating = false;
        };

        runCycle();
        setInterval(runCycle, 8000);

        window.addEventListener('language-change', () => {
            isAnimating = false;
            runCycle();
        });
    };

    setTimeout(initHybridDemo, 100);
</script>