---
import { Sparkles, CalendarDays, Moon, Repeat, MoveHorizontal } from 'lucide-react';
---
<section id="features" class="py-24 relative z-10 bg-transparent transition-colors duration-300">
    
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-gray-700 to-transparent opacity-80 dark:opacity-30 transition-opacity duration-300"></div>

    <div id="features-carousel" class="max-w-6xl mx-auto px-6 flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-pl-6 pb-4 features-scrollbar-hide md:block md:space-y-32 md:gap-0 md:overflow-visible md:snap-none md:scroll-pl-0 md:pb-0">

        <!-- ========================================== -->
        <!-- FEATURE 1: SmartCheck AI                   -->
        <!-- ========================================== -->
        <div class="w-[85%] shrink-0 snap-start md:w-auto bg-white dark:bg-[#111827] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xl p-6 md:bg-transparent md:dark:bg-transparent md:border-0 md:shadow-none md:p-0 md:rounded-none flex flex-col md:flex-row items-center gap-6 md:gap-12">
            <div class="flex-1 flex flex-col items-center text-center md:items-start md:text-left space-y-4 md:space-y-6">
                <div class="w-12 h-12 rounded-xl bg-[#cc2229]/10 flex items-center justify-center text-[#cc2229]">
                    <Sparkles size={24} />
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white tracking-tight" data-es="SmartCheck AI" data-en="SmartCheck AI">SmartCheck AI</h3>
                <p class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed" data-es="El motor inteligente evalúa tus fechas de entrega y carga de trabajo para clasificar el riesgo en Alto, Medio o Bajo. No pienses qué hacer, deja que el asistente te guíe con un plan diario razonado." data-en="The intelligent engine evaluates your deadlines and workload to classify the risk as High, Medium, or Low. Don't think about what to do, let the assistant guide you with a reasoned daily plan.">
                    El motor inteligente evalúa tus fechas de entrega y carga de trabajo para clasificar el riesgo en Alto, Medio o Bajo. No pienses qué hacer, deja que el asistente te guíe con un plan diario razonado.
                </p>
            </div>

            <div class="w-full md:flex-1 rounded-2xl overflow-hidden md:bg-white md:dark:bg-[#0b1120] md:border md:border-gray-200 md:dark:border-gray-800 md:shadow-xl">
                
                <!-- Contenedor ESPAÑOL -->
                <div class="lang-es-wrapper w-full h-full">
                    <!-- Claro -->
                    <picture class="block dark:hidden">
                        <source srcset="/images/f1-es-light.webp?v=2" type="image/webp"/>
                        <img src="/images/f1-es-light.png?v=2" alt="SmartCheck AI Claro" width="1341" height="923" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                    <!-- Oscuro -->
                    <picture class="hidden dark:block">
                        <source srcset="/images/f1-es-dark.webp?v=2" type="image/webp"/>
                        <img src="/images/f1-es-dark.png?v=2" alt="SmartCheck AI Oscuro" width="1341" height="923" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                </div>

                <!-- Contenedor INGLÉS -->
                <div class="lang-en-wrapper w-full h-full">
                    <!-- Claro -->
                    <picture class="block dark:hidden">
                        <source srcset="/images/f1-en-light.webp?v=2" type="image/webp"/>
                        <img src="/images/f1-en-light.png?v=2" alt="SmartCheck AI Light" width="1341" height="923" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                    <!-- Oscuro -->
                    <picture class="hidden dark:block">
                        <source srcset="/images/f1-en-dark.webp?v=2" type="image/webp"/>
                        <img src="/images/f1-en-dark.png?v=2" alt="SmartCheck AI Dark" width="1341" height="923" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                </div>

            </div>
        </div>
        
        <!-- ========================================== -->
        <!-- FEATURE 2: Progreso Visual Constante       -->
        <!-- ========================================== -->
        <div class="w-[85%] shrink-0 snap-start md:w-auto bg-white dark:bg-[#111827] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xl p-6 md:bg-transparent md:dark:bg-transparent md:border-0 md:shadow-none md:p-0 md:rounded-none flex flex-col md:flex-row-reverse items-center gap-6 md:gap-12">
            <div class="flex-1 flex flex-col items-center text-center md:items-start md:text-left space-y-4 md:space-y-6">
                <div class="w-12 h-12 rounded-xl bg-[#00b87c]/10 flex items-center justify-center text-[#00b87c]">
                    <CalendarDays size={24} />
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white tracking-tight" data-es="Progreso Visual Constante" data-en="Constant Visual Progress">Progreso Visual Constante</h3>
                <p class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed" data-es="Mantén la motivación en todo lo alto. El mapa de calor interactivo te muestra tu constancia diaria de un solo vistazo. Visualiza tus rachas y equilibra tu esfuerzo entre asignaturas." data-en="Keep your motivation high. The interactive heatmap shows your daily consistency at a single glance. Visualize your streaks and balance your effort across subjects.">
                    Mantén la motivación en todo lo alto. El mapa de calor interactivo te muestra tu constancia diaria de un solo vistazo. Visualiza tus rachas y equilibra tu esfuerzo entre asignaturas.
                </p>
            </div>

            <div class="w-full md:flex-1 rounded-2xl overflow-hidden md:bg-white md:dark:bg-[#0b1120] md:border md:border-gray-200 md:dark:border-gray-800 md:shadow-xl">
                
                <!-- Contenedor ESPAÑOL -->
                <div class="lang-es-wrapper w-full h-full">
                    <!-- Claro -->
                    <picture class="block dark:hidden">
                        <source srcset="/images/f2-es-light.webp?v=2" type="image/webp"/>
                        <img src="/images/f2-es-light.png?v=2" alt="Progreso Claro" width="1076" height="672" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                    <!-- Oscuro -->
                    <picture class="hidden dark:block">
                        <source srcset="/images/f2-es-dark.webp?v=2" type="image/webp"/>
                        <img src="/images/f2-es-dark.png?v=2" alt="Progreso Oscuro" width="1076" height="672" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                </div>

                <!-- Contenedor INGLÉS -->
                <div class="lang-en-wrapper w-full h-full">
                    <!-- Claro -->
                    <picture class="block dark:hidden">
                        <source srcset="/images/f2-en-light.webp?v=2" type="image/webp"/>
                        <img src="/images/f2-en-light.png?v=2" alt="Progress Light" width="1076" height="672" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                    <!-- Oscuro -->
                    <picture class="hidden dark:block">
                        <source srcset="/images/f2-en-dark.webp?v=2" type="image/webp"/>
                        <img src="/images/f2-en-dark.png?v=2" alt="Progress Dark" width="1076" height="672" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                </div>

            </div>
        </div>

        <!-- ========================================== -->
        <!-- FEATURE 3: Experiencia sin fricciones      -->
        <!-- ========================================== -->
        <div class="w-[85%] shrink-0 snap-start md:w-auto bg-white dark:bg-[#111827] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xl p-6 md:bg-transparent md:dark:bg-transparent md:border-0 md:shadow-none md:p-0 md:rounded-none flex flex-col md:flex-row items-center gap-6 md:gap-12">
            <div class="flex-1 flex flex-col items-center text-center md:items-start md:text-left space-y-4 md:space-y-6">
                <div class="w-12 h-12 rounded-xl bg-gray-200 dark:bg-gray-800 flex items-center justify-center text-gray-700 dark:text-gray-300">
                    <Moon size={24} />
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white tracking-tight" data-es="Experiencia sin fricciones" data-en="Frictionless experience">Experiencia sin fricciones</h3>
                <p class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed" data-es="Una herramienta que no da pereza usar. Disfruta de un modo noche nativo que cuida tu vista, un diseño adaptativo y animaciones fluidas que hacen de la productividad un placer." data-en="A tool that isn't a chore to use. Enjoy a native night mode that protects your eyes, an adaptive design, and fluid animations that make productivity a pleasure.">
                    Una herramienta que no da pereza usar. Disfruta de un modo noche nativo que cuida tu vista, un diseño adaptativo y animaciones fluidas que hacen de la productividad un placer.
                </p>
            </div>

            <div class="w-full md:flex-1 rounded-2xl overflow-hidden md:bg-white md:dark:bg-[#0b1120] md:border md:border-gray-200 md:dark:border-gray-800 md:shadow-xl">
                
                <!-- Contenedor ESPAÑOL (Usando GIF dinámico) -->
                <div class="lang-es-wrapper w-full h-full">
                    <picture>
                        <source srcset="/images/f3-es.webp?v=3" type="image/webp"/>
                        <img src="/images/f3-es.gif?v=3" alt="Transición Modo Noche" width="800" height="388" loading="lazy" decoding="async" class="w-full h-auto block"/>
                    </picture>
                </div>

                <!-- Contenedor INGLÉS (Usando GIF dinámico) -->
                <div class="lang-en-wrapper w-full h-full">
                    <picture>
                        <source srcset="/images/f3-en.webp?v=3" type="image/webp"/>
                        <img src="/images/f3-en.gif?v=3" alt="Dark Mode Transition" width="800" height="388" loading="lazy" decoding="async" class="w-full h-auto block"/>
                    </picture>
                </div>

            </div>
        </div>

        <!-- ========================================== -->
        <!-- FEATURE 4: Rutinas Recurrentes             -->
        <!-- ========================================== -->
        <div class="w-[85%] shrink-0 snap-start md:w-auto bg-white dark:bg-[#111827] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xl p-6 md:bg-transparent md:dark:bg-transparent md:border-0 md:shadow-none md:p-0 md:rounded-none flex flex-col md:flex-row-reverse items-center gap-6 md:gap-12">
            <div class="flex-1 flex flex-col items-center text-center md:items-start md:text-left space-y-4 md:space-y-6">
                <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400">
                    <Repeat size={24} />
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white tracking-tight" data-es="Rutinas Recurrentes" data-en="Recurring Routines">Rutinas Recurrentes</h3>
                <p class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed" data-es="Automatiza tu flujo de trabajo. Configura patrones de repetición personalizados (diarios, semanales o mensuales) y deja que RedCheck instancie tus tareas automáticamente para que no olvides nada." data-en="Automate your workflow. Set up custom repetition patterns (daily, weekly, or monthly) and let RedCheck automatically instantiate your tasks so you never forget a thing.">
                    Automatiza tu flujo de trabajo. Configura patrones de repetición personalizados (diarios, semanales o mensuales) y deja que RedCheck instancie tus tareas automáticamente para que no olvides nada.
                </p>
            </div>

            <div class="w-full md:flex-1 rounded-2xl overflow-hidden md:bg-white md:dark:bg-[#0b1120] md:border md:border-gray-200 md:dark:border-gray-800 md:shadow-xl">
                
                <!-- Contenedor ESPAÑOL -->
                <div class="lang-es-wrapper w-full h-full">
                    <!-- Claro -->
                    <picture class="block dark:hidden">
                        <source srcset="/images/f4-es-light.webp" type="image/webp"/>
                        <img src="/images/f4-es-light.png" alt="Rutinas Recurrentes Claro" width="503" height="357" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                    <!-- Oscuro -->
                    <picture class="hidden dark:block">
                        <source srcset="/images/f4-es-dark.webp" type="image/webp"/>
                        <img src="/images/f4-es-dark.png" alt="Rutinas Recurrentes Oscuro" width="503" height="357" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                </div>

                <!-- Contenedor INGLÉS -->
                <div class="lang-en-wrapper w-full h-full">
                    <!-- Claro -->
                    <picture class="block dark:hidden">
                        <source srcset="/images/f4-en-light.webp" type="image/webp"/>
                        <img src="/images/f4-en-light.png" alt="Recurring Routines Light" width="503" height="357" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                    <!-- Oscuro -->
                    <picture class="hidden dark:block">
                        <source srcset="/images/f4-en-dark.webp" type="image/webp"/>
                        <img src="/images/f4-en-dark.png" alt="Recurring Routines Dark" width="503" height="357" loading="lazy" decoding="async" class="w-full h-auto"/>
                    </picture>
                </div>

            </div>
        </div>

    </div>

    <!-- Pista de swipe (solo móvil) -->
    <div class="flex md:hidden items-center justify-center gap-2 mt-2 text-xs font-semibold text-gray-400 dark:text-gray-500">
        <MoveHorizontal size={14} class="features-swipe-icon" />
        <span data-es="Desliza para ver todas las características" data-en="Swipe to see all the features">Desliza para ver todas las características</span>
    </div>
</section>

<!-- LA MAGIA MULTI-IDIOMA EN CSS PURO -->
<style is:global>
    /* Cuando el idioma es español, ocultamos el bloque de imágenes en inglés */
    html[lang="es"] .lang-en-wrapper {
        display: none !important;
    }

    /* Cuando el idioma es inglés, ocultamos el bloque de imágenes en español */
    html[lang="en"] .lang-es-wrapper {
        display: none !important;
    }
</style>

<style>
    /* Oculta la barra de scroll nativa del carrusel de features en móvil
       (el swipe con el dedo sigue funcionando igual, solo se oculta el indicador visual) */
    #features-carousel.features-scrollbar-hide {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    #features-carousel.features-scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    /* Pequeño balanceo horizontal en el icono de la pista de swipe */
    @keyframes featuresSwipeNudge {
        0%, 100% { transform: translateX(-3px); opacity: 0.6; }
        50% { transform: translateX(3px); opacity: 1; }
    }
    .features-swipe-icon {
        animation: featuresSwipeNudge 1.6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .features-swipe-icon {
            animation: none;
        }
    }
</style>