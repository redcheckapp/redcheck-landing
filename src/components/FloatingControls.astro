---
// Eliminamos la importación de lucide-react para evitar el colapso del servidor
---

<div class="fixed bottom-4 left-4 z-50 flex flex-col gap-2">
    <!-- Botón de Idioma (Español / Inglés) -->
    <button
        id="lang-toggle"
        class="p-3 rounded-2xl bg-white dark:bg-gray-900 shadow-xl border border-gray-100 dark:border-gray-800 text-gray-800 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-300 active:scale-95 flex items-center justify-center text-lg leading-none"
        title="Cambiar idioma / Change language"
        aria-label="Cambiar idioma"
    >
        <span id="lang-flag">🇪🇸</span>
    </button>

    <!-- Botón de Modo Noche -->
    <button
        id="theme-toggle"
        class="p-3 rounded-2xl bg-white dark:bg-gray-900 shadow-xl border border-gray-100 dark:border-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-300 active:scale-95"
        title="Cambiar tema"
        aria-label="Alternar modo de color"
    >
        <!-- Icono Luna (SVG Puro) visible en modo claro -->
        <span class="block dark:hidden flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
        </span>
        <!-- Icono Sol (SVG Puro) visible en modo oscuro -->
        <span class="hidden dark:block flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
        </span>
    </button>
</div>

<script is:inline>
    // --- LÓGICA DE TEMA (MODO NOCHE) ---
    const handleThemeToggle = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");
        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
    };

    document.getElementById("theme-toggle")?.addEventListener("click", handleThemeToggle);

    // --- LÓGICA DE IDIOMA (ES / EN) ---
    const updateLanguageUI = (lang) => {
        const flagSpan = document.getElementById("lang-flag");
        if (flagSpan) {
            flagSpan.textContent = lang === 'en' ? '🇬🇧' : '🇪🇸';
        }
        
        // Traducir todos los elementos con data-es / data-en
        document.querySelectorAll("[data-es]").forEach(el => {
            el.textContent = el.getAttribute(`data-${lang}`);
        });

        // Actualizar la etiqueta <html> por temas de SEO y accesibilidad
        document.documentElement.lang = lang;
    };

    const handleLangToggle = () => {
        const currentLang = localStorage.getItem("lang") || "es";
        const newLang = currentLang === "es" ? "en" : "es";
        
        localStorage.setItem("lang", newLang);
        updateLanguageUI(newLang);
        
        // Disparar evento por si algún componente necesita enterarse
        window.dispatchEvent(new CustomEvent('language-change', { detail: newLang }));
    };

    document.getElementById("lang-toggle")?.addEventListener("click", handleLangToggle);

    // --- INICIALIZACIÓN INTELIGENTE DE IDIOMA ---
    const initLanguage = () => {
        let savedLang = localStorage.getItem("lang");
        
        // Si es la primera visita (no hay idioma guardado en localStorage)
        if (!savedLang) {
            const browserLang = navigator.language || navigator.userLanguage || "";
            // Si el idioma empieza por "es" usamos español. Caso contrario, inglés.
            savedLang = browserLang.toLowerCase().startsWith('es') ? 'es' : 'en';
            localStorage.setItem("lang", savedLang);
        }
        
        updateLanguageUI(savedLang);
    };

    // Ejecutar al cargar
    initLanguage();
</script>