---
import '../styles/global.css';
import { ScrollParticles } from '../components/react/ScrollParticles.tsx';
import FloatingControls from '../components/FloatingControls.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="RedCheck: Tu agenda, ahora com inteligencia artificial." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		
		<!-- Script bloqueante para evitar flash de tema e idioma -->
		<script is:inline>
			const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			if (theme === 'dark') document.documentElement.classList.add('dark');
		</script>
	</head>
	
	<body class="bg-gray-50 dark:bg-[#0b1120] text-gray-900 dark:text-gray-100 antialiased selection:bg-[#cc2229]/30 selection:text-red-200 overflow-x-hidden transition-colors duration-300">
		
		<ScrollParticles client:load />

		<slot />
		
		<!-- Panel flotante con Idioma y Modo Noche -->
		<FloatingControls />
	</body>
</html>