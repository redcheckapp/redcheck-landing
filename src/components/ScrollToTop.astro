<button
    id="scroll-to-top"
    class="fixed bottom-4 right-4 z-50 p-3 rounded-full bg-white dark:bg-gray-900 shadow-xl border border-gray-100 dark:border-gray-800 text-gray-600 dark:text-gray-300 hover:text-[#cc2229] dark:hover:text-[#cc2229] hover:bg-gray-50 dark:hover:bg-gray-800 transition-all duration-500 active:scale-95 opacity-0 translate-y-10 pointer-events-none flex items-center justify-center"
    aria-label="Volver arriba"
    title="Volver arriba"
>
    <!-- Icono ChevronUp de Lucide (SVG Puro) -->
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 15-6-6-6 6"/>
    </svg>
</button>

<script is:inline>
    const scrollBtn = document.getElementById('scroll-to-top');

    if (scrollBtn) {
        const toggleScrollButton = () => {
            // Calculamos el tamaño total scrolleable
            const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
            const currentScroll = window.scrollY;

            // Si hemos bajado más del 50% de la página, lo mostramos
            if (currentScroll > scrollTotal / 2) {
                scrollBtn.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
                scrollBtn.classList.add('opacity-100', 'translate-y-0');
            } else {
                // Si estamos en la mitad superior, lo ocultamos
                scrollBtn.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
                scrollBtn.classList.remove('opacity-100', 'translate-y-0');
            }
        };

        // Escuchamos el scroll de forma pasiva para no afectar al rendimiento
        window.addEventListener('scroll', toggleScrollButton, { passive: true });

        // Acción al hacer clic: subir suavemente
        scrollBtn.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
    }
</script>