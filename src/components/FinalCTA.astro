---
import { ArrowRight } from 'lucide-react';
---
<!-- Aumentamos un poco el padding superior (pt-32) para separar bien las secciones -->
<section class="pb-24 pt-32 md:pt-40 relative overflow-hidden z-10">
    
    <!-- SEPARADOR VISUAL: Línea muy sutil con gradiente (se desvanece a los lados) -->
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-gray-700 to-transparent opacity-50"></div>

    <!-- Fondo base transparente para dejar ver las partículas -->
    <div class="absolute inset-0 bg-transparent transition-colors duration-300"></div>
    
    <!-- Brillo rojo degradado desde el centro para resaltar la zona del botón -->
    <div class="absolute inset-0 bg-[#cc2229]/5 dark:bg-[#cc2229]/15 [mask-image:radial-gradient(ellipse_at_center,black,transparent_80%)] transition-colors duration-300"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white tracking-tight mb-6 transition-colors duration-300" data-es="¿Listo para tomar el control de tu tiempo?" data-en="Ready to take control of your time?">
            ¿Listo para tomar el control de tu tiempo?
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 font-medium mb-10 max-w-2xl mx-auto transition-colors duration-300" data-es="Únete a RedCheck y descubre cómo la inteligencia artificial puede transformar tu forma de organizarte." data-en="Join RedCheck and discover how artificial intelligence can transform the way you organize yourself.">
            Únete a RedCheck y descubre cómo la inteligencia artificial puede transformar tu forma de organizarte.
        </p>
        
        <a href="https://app.redcheck.es/register" class="group relative inline-flex items-center justify-center gap-2 px-10 py-5 bg-[#cc2229] hover:bg-[#a81a20] text-white text-lg font-bold rounded-xl overflow-hidden transition-all shadow-[0_0_30px_rgba(204,34,41,0.3)] hover:shadow-[0_0_40px_rgba(204,34,41,0.5)] hover:scale-105 active:scale-95">
            <span data-es="Crear cuenta gratuita" data-en="Create free account">Crear cuenta gratuita</span>
            <ArrowRight size={20} class="transition-transform group-hover:translate-x-1" />
        </a>
    </div>
</section>