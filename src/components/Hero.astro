---
import { ArrowRight, Sparkles } from 'lucide-react';
---

<section class="relative min-h-screen flex items-center justify-center pt-20 pb-32 overflow-hidden">
    
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-[#cc2229]/10 dark:bg-[#cc2229]/15 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 left-1/4 w-[400px] h-[300px] bg-[#00b87c]/10 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center flex flex-col items-center">
        
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#cc2229]/10 border border-[#cc2229]/20 backdrop-blur-md mb-8">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-[#cc2229]/20 text-[#cc2229]">
                <Sparkles size={12} />
            </span>
            <span class="text-xs font-semibold tracking-wide text-gray-800 dark:text-gray-300" data-es="Presentamos SmartCheck AI V2" data-en="Introducing SmartCheck AI V2">Presentamos SmartCheck AI V2</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-black tracking-tight text-gray-900 dark:text-white mb-6 leading-[1.1]">
            <span data-es="Tu día, organizado por" data-en="Your day, organized by">Tu día, organizado por</span> <br/>
            <span class="text-[#cc2229]" data-es="Inteligencia Artificial." data-en="Artificial Intelligence.">
                Inteligencia Artificial.
            </span>
        </h1>

        <p class="mt-4 text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-2xl font-medium leading-relaxed mb-10" data-es="Una agenda inteligente que analiza tus tareas, evalúa los riesgos y crea tu plan de ejecución ideal. Deja de planificar y empieza a hacer." data-en="A smart planner that analyzes your tasks, evaluates risks, and creates your ideal execution plan. Stop planning and start doing.">
            Una agenda inteligente que analiza tus tareas, evalúa los riesgos y crea tu plan de ejecución ideal. Deja de planificar y empieza a hacer.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="https://app.redcheck.es/register" class="group relative inline-flex items-center justify-center gap-2 w-full sm:w-auto px-8 py-4 bg-[#00b87c] hover:bg-[#009c69] text-white font-bold rounded-xl overflow-hidden transition-all hover:shadow-[0_0_20px_rgba(0,184,124,0.4)] hover:scale-105 active:scale-95">
                <span data-es="Probar Demo Gratis" data-en="Try Free Demo">Probar Demo Gratis</span>
                <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
            </a>
            
            <a href="#features" class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-4 bg-white dark:bg-[#111827] hover:bg-gray-50 dark:hover:bg-[#1f2937] text-gray-900 dark:text-white font-semibold rounded-xl border border-gray-200 dark:border-gray-800 transition-all hover:scale-105 active:scale-95 shadow-sm dark:shadow-none">
                <span data-es="Ver características" data-en="See features">Ver características</span>
            </a>
        </div>
        
        <div class="mt-16 w-full max-w-5xl mx-auto rounded-xl md:rounded-2xl border border-gray-200 dark:border-gray-800 shadow-2xl overflow-hidden animate-fade-in-up transition-colors duration-300">
            <img 
                src="https://via.placeholder.com/1200x675/0b1120/ffffff?text=Captura+del+Dashboard+de+RedCheck" 
                alt="Panel de control de RedCheck" 
                class="w-full h-auto object-cover"
            />
        </div>
    </div>
</section>