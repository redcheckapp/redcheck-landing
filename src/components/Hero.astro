---
import { ArrowRight, Sparkles } from 'lucide-react';
import QuickDemo from './QuickDemo.astro';
---

<!-- Reducimos el padding vertical general (de pt-20/pb-32 a pt-12/pb-12) -->
<section class="relative min-h-screen flex items-center justify-center pt-28 pb-12 md:pt-16 overflow-x-hidden">
    
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-[#cc2229]/25 dark:bg-[#cc2229]/15 blur-[120px] rounded-full pointer-events-none transition-colors duration-300"></div>
    
    <div class="absolute bottom-0 left-1/4 w-[400px] h-[300px] bg-[#00b87c]/20 dark:bg-[#00b87c]/10 blur-[100px] rounded-full pointer-events-none transition-colors duration-300"></div>
    
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:linear-gradient(to_bottom,black_40%,transparent_100%)] pointer-events-none"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center flex flex-col items-center">

        <!-- Reducimos el margen inferior (mb-6 a mb-4) -->
        <h1 class="text-5xl md:text-7xl font-black tracking-tight text-gray-900 dark:text-white mb-4 leading-[1.1]">
            <span data-es="Tu día, organizado por" data-en="Your day, organized by">Tu día, organizado por</span> <br/>
            <span class="text-[#cc2229]" data-es="Inteligencia Artificial." data-en="Artificial Intelligence.">
                Inteligencia Artificial.
            </span>
        </h1>

        <!-- Reducimos el margen inferior (mb-10 a mb-7) -->
        <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-2xl font-medium leading-relaxed mb-7" data-es="Una agenda inteligente que analiza tus tareas, evalúa los riesgos y crea tu plan de ejecución ideal. Deja de planificar y empieza a hacer." data-en="A smart planner that analyzes your tasks, evaluates risks, and creates your ideal execution plan. Stop planning and start doing.">
            Una agenda inteligente que analiza tus tareas, evalúa los riesgos y crea tu plan de ejecución ideal. Deja de planificar y empieza a hacer.
        </p>

        <!-- Reducimos ligeramente el padding de los botones (py-4 a py-3.5) -->
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
            <a href="https://my.redcheckapp.com/login" class="group relative inline-flex items-center justify-center gap-2 w-full sm:w-auto px-8 py-3.5 bg-[#00b87c] hover:bg-[#009c69] text-white font-bold rounded-xl overflow-hidden transition-all hover:shadow-[0_0_20px_rgba(0,184,124,0.4)] hover:scale-105 active:scale-95">
                <span data-es="Probar Demo Gratis" data-en="Try Free Demo">Probar Demo Gratis</span>
                <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
            </a>
            
            <a href="#features" class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-3.5 bg-white dark:bg-[#111827] hover:bg-gray-50 dark:hover:bg-[#1f2937] text-gray-900 dark:text-white font-semibold rounded-xl border border-gray-200 dark:border-gray-800 transition-all hover:scale-105 active:scale-95 shadow-sm dark:shadow-none">
                <span data-es="Ver características" data-en="See features">Ver características</span>
            </a>
        </div>
        
        <!-- Reducimos drásticamente el espacio antes de la demo (mt-16 a mt-8) -->
        <div class="mt-8 md:mt-10 w-full max-w-4xl mx-auto animate-fade-in-up transition-colors duration-300">
            <QuickDemo />
        </div>
    </div>
</section>