---
import { LogIn, LayoutDashboard } from 'lucide-react';
---

<!-- Añadimos un ID y clases de transición (transition-transform duration-300 translate-y-0) -->
<div id="smart-navbar-container" class="fixed top-6 inset-x-0 z-50 flex justify-center px-4 pointer-events-none transition-transform duration-300 ease-in-out translate-y-0">
    
    <nav class="pointer-events-auto h-14 sm:h-16 w-full max-w-5xl bg-white/70 dark:bg-[#0b1120]/70 backdrop-blur-lg border border-gray-200/80 dark:border-gray-700/80 rounded-2xl flex items-center justify-between px-3 sm:px-4 shadow-xl">

        <!-- Logo -->
        <a href="#" class="flex items-center gap-2 sm:gap-3 transition-opacity hover:opacity-90 min-w-0">
            <div class="bg-[#cc2229] w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center shadow-sm flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-white sm:w-5 sm:h-5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <span class="text-base sm:text-xl font-black text-gray-900 dark:text-white tracking-tight whitespace-nowrap">REDCHECK</span>
        </a>

        <!-- Botón Dinámico -->
        <a
            id="smart-auth-btn"
            href="https://my.redcheckapp.com/login"
            class="flex items-center gap-1.5 sm:gap-2 px-3 py-2 sm:px-4 rounded-xl bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium text-xs sm:text-sm hover:opacity-90 transition-opacity flex-shrink-0 whitespace-nowrap"
        >
            <span id="auth-icon-login" class="block"><LogIn size={14} /></span>
            <span id="auth-icon-dash" class="hidden"><LayoutDashboard size={14} /></span>
            <span id="smart-auth-text" data-es="Iniciar Sesión" data-en="Log In">Iniciar Sesión</span>
        </a>

    </nav>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        // ==========================================
        // 1. LÓGICA DE SESIÓN (Salto Invisible)
        // ==========================================
        const authBtn = document.getElementById('smart-auth-btn');
        const authText = document.getElementById('smart-auth-text');
        const iconLogin = document.getElementById('auth-icon-login');
        const iconDash = document.getElementById('auth-icon-dash');

        const isSessionActive = document.cookie.includes('redcheck_session=active');
        const lang = document.documentElement.lang || 'es';

        if (isSessionActive) {
            authBtn.href = "https://app.redcheck.es/";
            authText.setAttribute('data-es', 'Ir a mi Panel');
            authText.setAttribute('data-en', 'Go to Dashboard');
            authText.textContent = lang === 'en' ? 'Go to Dashboard' : 'Ir a mi Panel';
            
            iconLogin.classList.add('hidden');
            iconLogin.classList.remove('block');
            iconDash.classList.remove('hidden');
            iconDash.classList.add('block');
        }

        // ==========================================
        // 2. LÓGICA DE AUTO-HIDE AL HACER SCROLL
        // ==========================================
        const navbarContainer = document.getElementById('smart-navbar-container');
        let lastScrollY = window.scrollY;

        window.addEventListener('scroll', () => {
            const currentScrollY = window.scrollY;
            
            // Si hacemos scroll hacia abajo y hemos pasado los primeros 100px
            if (currentScrollY > lastScrollY && currentScrollY > 100) {
                // Escondemos la barra trasladándola fuera de la pantalla
                navbarContainer.classList.add('-translate-y-[150%]');
                navbarContainer.classList.remove('translate-y-0');
            } else {
                // Si hacemos scroll hacia arriba, la devolvemos a su sitio
                navbarContainer.classList.add('translate-y-0');
                navbarContainer.classList.remove('-translate-y-[150%]');
            }
            
            lastScrollY = currentScrollY;
        }, { passive: true });
    });

    // ==========================================
    // 3. CAMBIO DE IDIOMA DINÁMICO
    // ==========================================
    window.addEventListener('language-change', () => {
        const authText = document.getElementById('smart-auth-text');
        const lang = document.documentElement.lang || 'es';
        authText.textContent = authText.getAttribute(`data-${lang}`);
    });
</script>