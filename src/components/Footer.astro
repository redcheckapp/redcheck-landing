---
const currentYear = new Date().getFullYear();
---
<footer class="bg-gray-50 dark:bg-[#0b1120] border-t border-gray-200 dark:border-gray-800 transition-colors duration-300 pt-16 pb-8 relative z-20">
    <div class="max-w-6xl mx-auto px-6">
        
        <div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-8 mb-12">
            <div class="flex flex-col items-center md:items-start max-w-sm text-center md:text-left">
                <div class="flex items-center gap-3 mb-4">
                    <div class="bg-[#cc2229] w-10 h-10 rounded-xl flex items-center justify-center shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-white"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <span class="text-2xl font-black text-gray-900 dark:text-white tracking-tight">REDCHECK</span>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-400 font-medium" data-es="La agenda inteligente e interactiva impulsada por IA para maximizar tu productividad diaria." data-en="The interactive and smart planner powered by AI to maximize your daily productivity.">
                    La agenda inteligente e interactiva impulsada por IA para maximizar tu productividad diaria.
                </p>
            </div>

            <div class="flex gap-12 text-center md:text-left">
                <div class="flex flex-col gap-3">
                    <span class="text-gray-900 dark:text-white font-bold text-sm uppercase tracking-wider" data-es="Producto" data-en="Product">Producto</span>
                    <a href="https://app.redcheck.es/login" class="text-sm text-gray-500 dark:text-gray-400 hover:text-[#cc2229] dark:hover:text-[#cc2229] transition-colors" data-es="Iniciar sesión" data-en="Log in">Iniciar sesión</a>
                    <a href="#features" class="text-sm text-gray-500 dark:text-gray-400 hover:text-[#cc2229] dark:hover:text-[#cc2229] transition-colors" data-es="Características" data-en="Features">Características</a>
                </div>
                <div class="flex flex-col gap-3">
                    <span class="text-gray-900 dark:text-white font-bold text-sm uppercase tracking-wider" data-es="Legal" data-en="Legal">Legal</span>
                    <a href="https://app.redcheck.es/privacy" class="text-sm text-gray-500 dark:text-gray-400 hover:text-[#cc2229] dark:hover:text-[#cc2229] transition-colors" data-es="Privacidad" data-en="Privacy Policy">Privacidad</a>
                    <a href="https://app.redcheck.es/terms" class="text-sm text-gray-500 dark:text-gray-400 hover:text-[#cc2229] dark:hover:text-[#cc2229] transition-colors" data-es="Aviso Legal" data-en="Legal Notice">Aviso Legal</a>
                </div>
            </div>
        </div>

        <div class="w-full h-px bg-gray-200 dark:bg-gray-800 mb-8"></div>

        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-xs text-gray-500 dark:text-gray-500 text-center md:text-left">
                &copy; {currentYear} RedCheck. <span data-es="Desarrollado por Francisco Javier Molina Cuenca." data-en="Developed by Francisco Javier Molina Cuenca.">Desarrollado por Francisco Javier Molina Cuenca.</span><br/>
                <span data-es="Todos los derechos reservados." data-en="All rights reserved.">Todos los derechos reservados.</span>
            </p>
            
            <div class="flex gap-4">
                <a href="https://github.com/tu-usuario" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors" aria-label="GitHub">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                </a>
                <a href="https://linkedin.com/in/tu-usuario" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors" aria-label="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                </a>
                <a href="mailto:tu-email@ejemplo.com" class="text-gray-400 hover:text-[#cc2229] transition-colors" aria-label="Email">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                </a>
            </div>
        </div>
        
    </div>
</footer>